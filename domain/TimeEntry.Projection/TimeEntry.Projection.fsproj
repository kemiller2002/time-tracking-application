<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier 3 — Application / Projection / Orchestration.

    Coordinates projections and commands. Must not become a second semantic
    authority: if this project starts deciding which states are legal, the
    Tier 1/2 boundary has failed
    (.sde/architecture/FOUR-TIER-ARCHITECTURE.md). It therefore computes
    views and totals but delegates every legality question to
    `Capabilities` and every state change to `Transitions`.

    Still no infrastructure reference: serialization and transport are Tier 4.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <OtherFlags>$(OtherFlags) --warnon:1182</OtherFlags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Query.fs" />
    <Compile Include="Projection.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TimeEntry.Semantic/TimeEntry.Semantic.fsproj" />
    <ProjectReference Include="../TimeEntry.Transitions/TimeEntry.Transitions.fsproj" />
  </ItemGroup>

</Project>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelon.example/schemas/domain/config.schema.json",
  "title": "Ledger client configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_version", "timezone", "display", "features"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "projection_version": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["six_minute_controls", "theme"],
      "properties": {
        "six_minute_controls": {"type": "boolean"},
        "theme": {"enum": ["system", "light", "dark"]}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_uploads", "offline_commands", "reports"],
      "properties": {
        "evidence_uploads": {"type": "boolean"},
        "offline_commands": {"type": "boolean"},
        "reports": {"type": "boolean"}
      }
    }
  }
}

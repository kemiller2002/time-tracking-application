<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier 4 — WASM host. The ONLY C# in the repository.

    It exists for one mechanical reason: the WebAssembly JS-interop
    attributes are consumed by a Roslyn source generator, so [JSExport] is
    inert in an F# assembly — verified by publishing an F# module with
    [<JSExport>] and probing it in Chromium, where getAssemblyExports
    returned an empty object.

    It must stay pure marshalling: every method forwards a string to the F#
    kernel and returns a string, so it cannot inspect or decide anything
    about a command (TE-R-091). If a method here ever needs to know what a
    command means, the boundary has been breached.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <!--
      Trimming is ON, and the two suppressions below are narrow.

      It was off for two successive reasons, both now resolved:

      1. Reflection-based System.Text.Json in TimeEntry.Persistence (IL2026).
         Fixed by writing `Serialization` by hand against Utf8JsonWriter and
         JsonDocument. Note that the obvious fix — JsonSerializerContext with
         [JsonSerializable] — is NOT available: that is a Roslyn source
         generator, and F# does not run Roslyn generators, the same reason
         [JSExport] is inert in F#.

      2. FSharp.Core's `%A` formatting, which calls Type.InvokeMember
         (sformat.fs) and MakeGenericMethod (printf.fs). Fixed by wording every
         user-visible outcome explicitly in TimeEntry.Browser.Wording — which
         TE-R-053 required anyway, since `%A` was rendering F# union literals
         into the interface.

      What remains is FSharp.Core's own packaging, and neither warning is
      about reflection this application performs:

        IL2040  FSharp.Core's ILLink.Substitutions.xml names two embedded
                resources that its netstandard2.1 build does not contain. A
                failure to REMOVE a resource affects size, not behaviour.
        IL2104  The blanket "this assembly produced trim warnings".

      Suppressed rather than left to disable trimming for the whole app, and
      the result is verified rather than assumed: `npm run check:browser`
      drives the trimmed bundle through 104 checks in Chromium, including
      every rejection message.

      Bundle: 29 MB untrimmed, 11 MB trimmed.
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <NoWarn>$(NoWarn);IL2040;IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Served alongside the app bundle. styles.css is the adopted design
         system from static-ui-screens (DF-TE-0008), linked rather than
         copied so the design authority stays in one place. -->
    <WasmExtraFilesToDeploy Include="index.html" />
    <WasmExtraFilesToDeploy Include="sample-entry.json" />
    <WasmExtraFilesToDeploy Include="sample-entry-2.json" />
    <WasmExtraFilesToDeploy Include="sample-entry-3.json" />
    <WasmExtraFilesToDeploy Include="sample-catalogue.json" />
    <WasmExtraFilesToDeploy Include="sample-versions.json" />
    <WasmExtraFilesToDeploy Include="sample-preferences.json" />
    <WasmExtraFilesToDeploy Include="../../static-ui-screens/styles.css" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TimeEntry.Kernel/TimeEntry.Kernel.fsproj" />
  </ItemGroup>

</Project>
